# Derived preview bundles — regenerated by reference/build_preview.py
reference/preview-*.html
reference/desktop-*.html
reference/contact-sheet.html

# Raw rescue output. These are the images exactly as downloaded; the site
# itself uses the curated copies in assets/img/, which contain the same
# bytes under meaningful names. Re-derivable via reference/rescue_images.py.
reference/originals/

# Staging area for photo uploads. The relay's working copy of the
# submissions branch lands here, and tools/gallery.py add --email used to write
# contacts here; neither belongs in the published tree, so it stays untracked.
# Contact details now live in .contacts/, which IS tracked. Read the next
# section before assuming why that is safe.
submissions/

# .contacts/ is deliberately NOT ignored, and deliberately not moved here.
# It holds submitters' names and email addresses for the committee, and the
# safety of publishing them rests on one thing: GitHub Pages skips directories
# whose name starts with a dot, so .contacts/ is never served. That is not true
# of dot-FILES -- this very .gitignore is published at /.gitignore -- so the
# directory has to stay a directory.

# Wrangler's local build output, if the relay is developed in place.
relay/node_modules/
relay/.wrangler/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Python bytecode from tools/
__pycache__/
*.pyc
