# Derived preview bundles — regenerated by reference/build_preview.py
reference/preview-*.html
reference/desktop-*.html
reference/contact-sheet.html

# Raw rescue output. These are the images exactly as downloaded; the site itself
# uses the curated copies in assets/img/, which contain the same bytes under
# meaningful names. Re-derivable via reference/rescue_images.py.
reference/originals/

# Server-side state, if the site is ever developed against a checkout: the credit
# lines in photos.json, the contact log and the removals log. On the server these
# live outside the web root; here they are simply never committed. Nothing that
# holds submitter email addresses belongs in a repository, published or not.
suas-config.php
suas-data/

# A deploy key copied into the checkout, if anyone ever does that.
*.pem

# The deploy runbook holds the production SSH and cPanel credentials, so it lives
# on the machines that deploy and nowhere else: never committed, never pushed.
# The deploy procedure that can be published is in README.md.
DEPLOY.md

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
