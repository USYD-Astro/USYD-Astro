# Served by Apache on the Namecheap cPanel host.
#
# The site is PHP served straight out of this directory: there is no build step
# and no static generator, so the only things Apache has to be told are which
# file answers for a directory, and that nothing private is reachable from a URL.

DirectoryIndex index.php index.html

# Without this, /photos/thumbs/ is a browsable index of every photo on the site.
Options -Indexes

# Security headers. The site sent none of these before: PHP fills the response on
# a shared host, so Apache has to add them. HSTS is safe because the host already
# redirects http to https.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Inline <script>/<style> are load-bearing here (the construction notice and
  # the calendar's boot payload), so 'unsafe-inline' stays for both; the calendar
  # library is the one external script and Instagram's CDN the one remote image
  # source. Everything else is same-origin.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'"
</IfModule>

# Code, data and archive material, not pages. The first two live above this
# directory on the server anyway -- includes/ is only reachable if it is deployed
# here, and the data directory never is -- but a mistaken deploy should not be
# able to expose either. reference/ is the archived old site and the scripts that
# built it: a git checkout ships the whole tree, so it lands here whether or not
# anything links to it.
RedirectMatch 404 ^/(includes|data|reference)(/|$)

# Support material that has no business being fetched: the submission log, the
# config template, this repository's documentation, the deploy script.
<FilesMatch "\.(json|jsonl|log|sh|md)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(config\.example\.php)$">
  Require all denied
</FilesMatch>

# Deployment bookkeeping and repository metadata. They carry no secret, but they
# are not pages either, and a git checkout puts them in the web root where the
# extension rules above cannot reach them.
<FilesMatch "^(server-state\.txt|\.gitignore)$">
  Require all denied
</FilesMatch>
